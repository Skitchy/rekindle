{
  "name": "rekindle",
  "version": "0.2.0",
  "description": "Your AI forgets everything between sessions. Rekindle fixes that.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "rekindle": "dist/init/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "claude",
    "persistence",
    "orientation"
  ],
  "author": "Skitch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skitchy/rekindle.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "hooks",
    "docs",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
